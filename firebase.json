{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/privacy",
        "destination": "/privacy-policy",
        "type": 301
      },
      {
        "source": "/terms",
        "destination": "/terms-and-conditions",
        "type": 301
      },
      {
        "source": "/services/website-design",
        "destination": "/services/web-application",
        "type": 301
      }
    ]
  }
}
