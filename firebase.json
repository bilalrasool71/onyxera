{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|svg|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/seo-platform",
        "destination": "/seo-services",
        "type": 301
      },
      {
        "source": "/platforms/shopify",
        "destination": "/platforms/shopify-development-services",
        "type": 301
      },
      {
        "source": "/digital-marketing-platform",
        "destination": "/digital-marketing-services",
        "type": 301
      },
      {
        "source": "/development-platform",
        "destination": "/custom-development-solutions",
        "type": 301
      },
      {
        "source": "/cyber-security-platform",
        "destination": "/cybersecurity-solutions",
        "type": 301
      },
      {
        "source": "/automation-funnel",
        "destination": "/automation-solutions",
        "type": 301
      },
      {
        "source": "/shopify",
        "destination": "/platforms/shopify-development-services",
        "type": 301
      },
      {
        "source": "/gohighlevel",
        "destination": "/platforms/gohighlevel",
        "type": 301
      },
      {
        "source": "/odoo",
        "destination": "/platforms/odoo-erp",
        "type": 301
      },
      {
        "source": "/frappe-erpnext",
        "destination": "/platforms/frappe-erpnext",
        "type": 301
      },
      {
        "source": "/work/sift-health",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/our-portfolio/sift-health",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/work/northbank-clearing-ledger",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/our-portfolio/northbank-clearing-ledger",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/work/engineering-product-store",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/our-portfolio/engineering-product-store",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/work/vps-api-deployment",
        "destination": "/",
        "type": 301
